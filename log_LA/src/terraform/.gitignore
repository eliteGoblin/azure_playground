# Terraform state files
*.tfstate
*.tfstate.*

# Terraform lock file
.terraform.lock.hcl

# Terraform directory
.terraform/

# Crash log files
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable files that might contain secrets
*.tfvars
*.tfvars.json

# CLI configuration files
.terraformrc
terraform.rc
